# Copy this file to terraform.tfvars and fill in your values

cluster_name = "k8s-vanilla-lab"
aws_region   = "eu-west-1"
environment  = "lab"

# AWS authentication — set your SSO profile name for local use.
# Leave empty (or omit) in CI; OIDC credentials are set via environment variables.
aws_profile = "k8s-vanilla-lab"

# Lab member account ID (multi-account guard — never version the real value;
# in CI it comes from the LAB_ACCOUNT_ID GitHub Variable)
lab_account_id = "222222222222"

# REQUIRED: CIDR allowed for SSH and K8s API access. No default — set your IP
# (curl ifconfig.me) as x.x.x.x/32, or consciously open it with 0.0.0.0/0.
my_ip = "1.2.3.4/32"

# REQUIRED: Existing AWS SSH key pair name
ssh_key_name = "your-key-name"

# Optional: Override defaults
# worker_count                  = 2
# worker_capacity_type          = "spot"
# control_plane_instance_type   = "t3.medium"
# worker_instance_type          = "t3.medium"
# vpc_cidr                      = "10.0.0.0/16"
# public_subnet_cidr            = "10.0.1.0/24"
# project                       = "k8s-vanilla-lab"
# owner                         = "platform-engineering"
